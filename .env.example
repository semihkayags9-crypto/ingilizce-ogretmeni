# Bu dosyayi ".env" adiyla kopyala ve kendi anahtarini yaz.
# ONEMLI: .env dosyasini kimseyle paylasma, zip'e ekleme, GitHub'a yukleme.

# Groq API anahtari - https://console.groq.com adresinden ucretsiz alinir
GROQ_API_KEY=buraya_kendi_anahtarini_yaz

# Kullanilacak model (istege bagli, bos birakilirsa varsayilan kullanilir)
# Türkçe ve İngilizce için doğal yanıtlar veren güncel model:
GROQ_MODEL=qwen/qwen3.6-27b
